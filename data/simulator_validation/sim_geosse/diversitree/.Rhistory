t.test(diversitree_length_dat$crown_age,length_jl_df$crown_age)$p.value
plot_gamma = ggplot(gamma_dat, aes(x=gamma_type, y=value, fill=gamma_type)) +
geom_boxplot() +
ggtitle('gamma')  + scale_fill_discrete(name = "gamma") +
labs(x = "source")
print(plot_gamma)
t.test(diversitree_length_dat$gamma,length_jl_df$gamma)$p.value
plot_rho = ggplot(rho_dat, aes(x=rho_type, y=value, fill=rho_type)) +
geom_boxplot() +
ggtitle('pigot_rho')  + scale_fill_discrete(name = "pigot rho") +
labs(x = "source")
print(plot_rho)
t.test(diversitree_length_dat$rho,length_jl_df$rho)$p.value
t.test(diversitree_length_dat$pigot_rho,length_jl_df$pigot_rho)$p.value
